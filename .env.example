# Copier ce fichier en .env.local et renseigner les valeurs. Ne jamais committer .env.local.

# Mot de passe d'accès à l'app (mono-utilisateur)
APP_PASSWORD=change-me
# Secret de signature du cookie de session : générer avec `openssl rand -base64 32`
SESSION_SECRET=

# Postgres (Supabase) : chaîne de connexion du pooler (mode transaction, port 6543), utilisée par l'app
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# Chaîne de connexion directe (port 5432), utilisée uniquement pour les migrations
DATABASE_URL_DIRECT=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres

# API Anthropic (appelée côté serveur uniquement)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Langue des prompts générés
PROMPT_LANGUAGE=fr
