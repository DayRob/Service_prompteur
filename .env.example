# Copier ce fichier en .env.local et renseigner les valeurs. Ne jamais committer .env.local.

# Mot de passe d'accès à l'app (mono-utilisateur), 12 caractères minimum
APP_PASSWORD=
# Secret de signature du cookie de session : générer avec `openssl rand -base64 32`
SESSION_SECRET=

# Postgres. En dev local : `docker compose -f compose.dev.yaml up -d`
DATABASE_URL=postgresql://forge:forge@localhost:5432/forge

# Mettre à false uniquement pour tester en http hors localhost. Laisser true en production (HTTPS).
COOKIE_SECURE=true

# API Anthropic (appelée côté serveur uniquement)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Langue des prompts générés
PROMPT_LANGUAGE=fr
